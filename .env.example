# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Neon)
DATABASE_URL=

# Cache (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Auth (Clerk) — from Vercel Marketplace or Clerk dashboard
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# football-data.org — see docs/API_KEYS.md
FOOTBALL_DATA_API_TOKEN=

# API-Football — required for last 3 seasons; see docs/API_KEYS.md
API_FOOTBALL_KEY=

# Cron / admin protection
CRON_SECRET=

# Ingest window (season start years)
INGEST_SEASONS=2023,2024,2025
# Optional override for where CLI ingest writes JSON
DATA_RAW_DIR=../../data/raw
